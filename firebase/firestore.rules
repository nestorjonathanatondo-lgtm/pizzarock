rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menú público: todos pueden leer, solo admin escribe
    match /menu/{pizzaId} {
      allow read: if true;
      allow write: if request.auth != null; 
      // Para producción: allow write: if request.auth.token.admin == true;
    }
    
    // Órdenes: cualquiera puede crear, solo admin lee/actualiza
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Config / stats - solo admin
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
